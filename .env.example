# Copy to .env for local testing (`vercel dev`). On Vercel, add these under
# Project → Settings → Environment Variables instead. Never commit the real values.

# Cashfree dashboard → Developers → API Keys (use the Test/Sandbox keys first)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# "sandbox" for test keys, "production" for live keys
CASHFREE_ENV=sandbox

# Optional: your public site URL, used for payment return + webhook links
SITE_URL=
